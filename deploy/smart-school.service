# systemd *user* service: keeps the web app running on a Linux server.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/smart-school.service ~/.config/systemd/user/
#   # edit WorkingDirectory/ExecStart below if the project isn't in ~/kids-homework
#   systemctl --user daemon-reload
#   systemctl --user enable --now smart-school
#   sudo loginctl enable-linger "$USER"     # keep it running when you're not logged in
#
# Logs:  journalctl --user -u smart-school -f

[Unit]
Description=Smart School family dashboard
After=network-online.target

[Service]
WorkingDirectory=%h/kids-homework
ExecStart=%h/kids-homework/start.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
